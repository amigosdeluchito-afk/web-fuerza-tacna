<FilesMatch "\.pmtiles$">
    # 1. Configuración de CORS y Rangos
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Headers "Range"
        Header set Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges"
        Header set Accept-Ranges "bytes"
        
        # 🚨 LA BALA DE PLATA: Evita que Cloudflare o Nginx compriman el archivo y borren el Content-Length
        Header set Cache-Control "public, max-age=31536000, no-transform"
    </IfModule>

    # 2. Desactivar compresión nativa de Apache
    SetEnv no-gzip 1
    SetEnv no-brotli 1
    
    # 3. Forzar a que Apache lo trate como binario estricto
    ForceType application/octet-stream
</FilesMatch>

# Doble seguro: Regla de reescritura para apagar GZIP en hostings estrictos (cPanel/LiteSpeed)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule \.pmtiles$ - [E=no-gzip:1,E=no-brotli:1]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI "\.pmtiles$" no-gzip dont-vary
</IfModule>