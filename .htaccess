# Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
    # Cabeceras de Seguridad (Fase 1: Sin CSP)
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=86400"
</IfModule>

RewriteEngine On
RewriteBase /

# Solución HTTrack: Si piden una fuente .woff2, entregamos el archivo .html físico disfrazado con el tipo MIME correcto
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(assets/fonts/.+?)\.woff2$ $1.html [T=font/woff2,L]